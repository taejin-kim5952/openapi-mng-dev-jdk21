<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd" version="2.0">
    <description>KsmUtil functions library</description>
    <display-name>KsmUtil functions</display-name>
    <tlib-version>1.0</tlib-version>
    <short-name>ksmUtil</short-name>
    <uri>/WEB-INF/tld/KsmUtil.tld</uri>
    <function>
        <description>Safe string</description>
        <name>fnSafeStr</name>
        <function-class>com.kt.openapi.web.util.KsmUtil</function-class>
        <function-signature>java.lang.String fnSafeStr(java.lang.String)</function-signature>
        <example>
            ${ksmUtil:fnSafeStr(str)}
        </example>
    </function>
    <function>
        <description>Safe object</description>
        <name>fnSafeObj</name>
        <function-class>com.kt.openapi.web.util.KsmUtil</function-class>
        <function-signature>java.lang.Object fnSafeObj(java.lang.Object, java.lang.Object)</function-signature>
        <example>
            ${ksmUtil:fnSafeObj(obj, defaultObj)}
        </example>
    </function>
    <function>
        <description>Safe string (Object)</description>
        <name>fnSafeStrObj</name>
        <function-class>com.kt.openapi.web.util.KsmUtil</function-class>
        <function-signature>java.lang.String fnSafeStr(java.lang.Object)</function-signature>
        <example>${ksmUtil:fnSafeStrObj(obj)}</example>
    </function>
    <function>
        <description>Parse Int</description>
        <name>parseInt</name>
        <function-class>com.kt.openapi.web.util.KsmUtil</function-class>
        <function-signature>int parseInt(java.lang.Object, int)</function-signature>
        <example>${ksmUtil:parseInt(obj, 0)}</example>
    </function>
    <function>
        <description>Format Data</description>
        <name>fmt_data</name>
        <function-class>com.kt.openapi.web.util.KsmUtil</function-class>
        <function-signature>java.lang.String fmt_data(java.lang.String, java.lang.String)</function-signature>
        <example>${ksmUtil:fmt_data(str, 'fmt_xss_filter')}</example>
    </function>
</taglib>
<?xml version="1.0" encoding="UTF-8" ?>

<taglib xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd" version="2.0">
    <description>CommonFunc functions library</description>
    <display-name>CommonFunc functions</display-name>
    <tlib-version>1.0</tlib-version>
    <short-name>commonFunc</short-name>
    <uri>/WEB-INF/jsp/include/tld/CommonFunc.tld</uri>

    <function>
        <description>복호화</description>
        <name>safeDbDecrypt</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String safeDbDecrypt(java.lang.String)</function-signature>
        <example>
            ${commonFunc:safeDbDecrypt(str)}
        </example>
    </function>
    <function>
        <description>암호화(비밀번호)</description>
        <name>safeDbPassEncrypt</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String safeDbPassEncrypt(java.lang.String)</function-signature>
        <example>
            ${commonFunc:safeDbPassEncrypt(str)}
        </example>
    </function>
    <function>
        <description>마스킹</description>
        <name>fnMaskingInfo</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String fnMaskingInfo(java.lang.String, java.lang.String)</function-signature>
        <example>
            ${commonFunc:fnMaskingInfo(str, str)}
        </example>
    </function>
    <function>
        <description>암호화</description>
        <name>safeDbEncrypt</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String safeDbEncrypt(java.lang.String)</function-signature>
        <example>
            ${commonFunc:safeDbEncrypt(str)}
        </example>
    </function>
    <function>
        <description>API 상태</description>
        <name>fnDevStage</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String fnDevStage(java.lang.String, java.lang.String)</function-signature>
        <example>
            ${commonFunc:fnDevStage(str, str)}
        </example>
    </function>
    <function>
        <description>런타임 모드 체크</description>
        <name>isRunmodeTag</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>boolean isRunmodeTag(java.lang.String)</function-signature>
        <example>
            ${commonFunc:isRunmodeTag(str)}
        </example>
    </function>
    <function>
        <description>특정 사용자 체크</description>
        <name>isSpecificUser</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>boolean isSpecificUser(java.lang.String)</function-signature>
        <example>
            ${commonFunc:isSpecificUser(str)}
        </example>
    </function>
    <function>
        <description>활성 프로필</description>
        <name>getActiveProfile</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String getActiveProfile()</function-signature>
        <example>
            ${commonFunc:getActiveProfile()}
        </example>
    </function>
    <function>
        <description>URL Decode</description>
        <name>urlDecodeStr</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String urlDecodeStr(java.lang.String)</function-signature>
        <example>${commonFunc:urlDecodeStr(str)}</example>
    </function>
    <function>
        <description>Masking</description>
        <name>strMasking</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String strMasking(java.lang.String, java.lang.String)</function-signature>
        <example>${commonFunc:strMasking(str, 'phone')}</example>
    </function>
    <function>
        <description>YAML String Decode</description>
        <name>yamlStrDec</name>
        <function-class>com.kt.openapi.web.util.CommonFunc</function-class>
        <function-signature>java.lang.String yamlStrDec(java.lang.String)</function-signature>
        <example>${commonFunc:yamlStrDec(str)}</example>
    </function>
</taglib>
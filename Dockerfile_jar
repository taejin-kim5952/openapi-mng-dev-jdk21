# =============================================================================
# API Manager - JDK21 / Spring Boot 4 실행형 jar 이미지
#
# 기존 Dockerfile / Dockerfile_dev 는 "외부 Tomcat 9(javax) + WAR + JDK17" 전제라
# 이 프로젝트(<packaging>jar</packaging>, Boot 4.1.0, Java 21, jakarta)에는 쓸 수 없다.
#   - COPY target/*.war  -> 산출물이 jar 라서 매칭 실패로 빌드 중단
#   - Tomcat 9 는 javax 서블릿, Boot 4 는 jakarta  -> 배포돼도 기동 불가
#   - JDK 17 로는 Java 21 로 컴파일된 클래스를 못 읽음
# 그래서 내장 Tomcat 을 그대로 쓰는 jar 실행형으로 새로 작성한다.
#
# 빌드:
#   mvn -DskipTests clean package
#   docker build -f Dockerfile_jar -t apimanager:dev .
#
# 실행(예: tb 프로파일, 외부 8081 노출):
#   docker run -d --name apimanager -p 8081:8081 \
#     -e SPRING_PROFILES_ACTIVE=tb \
#     -e TB_DB_USERNAME=... -e TB_DB_PASSWORD=... \
#     apimanager:dev
# =============================================================================

FROM eclipse-temurin:21-jre

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Asia/Seoul

# 실행 프로파일. 빌드 시 --build-arg env=tb 로도, 실행 시 -e SPRING_PROFILES_ACTIVE 로도 지정 가능.
# (기존 Dockerfile 의 --build-arg env=... 사용법과 호환되도록 같은 인자명을 유지한다)
ARG env=tb
ENV SPRING_PROFILES_ACTIVE=${env}

WORKDIR /app

# Application Insights 에이전트. insights/ 가 비어 있어도 빌드가 깨지지 않도록 디렉터리째 복사한다.
COPY insights/ /insights/

# 에러 페이지(기존 Tomcat 이미지가 /usr/local/tomcat/public_error.html 로 쓰던 것)
COPY public_error.html /app/public_error.html

# 실행형 jar. Boot 4 는 target/*.jar 하나만 만들지만(.original 은 제외됨),
# 이름이 바뀌어도 되도록 와일드카드로 받는다.
COPY target/*.jar /app/app.jar

# 기존 WAR 이미지와 동일한 TLS 정책을 유지한다(사내 게이트웨이 연동 시 필요).
ENV JAVA_OPTS="-Djdk.tls.client.protocols=TLSv1.3,TLSv1.2 -Djdk.tls.client.cipherSuites=TLS_AES_128_GCM_SHA256,TLS_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384,TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256,TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384"

# application.yml 의 server.port 와 동일
EXPOSE 8081

# JAVA_OPTS 를 단어분리시켜야 해서 sh -c 를 쓴다. exec 로 감싸 PID 1 을 자바에 넘겨
# docker stop 시 SIGTERM 이 애플리케이션까지 전달되도록 한다(graceful shutdown).
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
